# Test case for manual_stepper gcode axes on a 5 axis printer
CONFIG rotary_axes.cfg
DICTIONARY atmega2560.dict

G28
MANUAL_STEPPER STEPPER=a ENABLE=1
MANUAL_STEPPER STEPPER=a STOP_ON_ENDSTOP=1 MOVE=-100 SPEED=30
MANUAL_STEPPER STEPPER=a SET_POSITION=0
MANUAL_STEPPER STEPPER=a GCODE_AXIS=A LIMIT_VELOCITY=60 LIMIT_ACCEL=600
MANUAL_STEPPER STEPPER=c ENABLE=1
MANUAL_STEPPER STEPPER=c SET_POSITION=0
MANUAL_STEPPER STEPPER=c GCODE_AXIS=C LIMIT_VELOCITY=90 LIMIT_ACCEL=900

G1 X50 Y50 Z10 A30 C90 F6000
G1 X60 Y60 E1 A45 C180
G1 X80 Y60 A-45 C-180 E2
G1 A0 C0
G1 E3
G10
G1 X70 A10
G11
G91
G1 X1 A10 C-10 E0.1
G90
G92 A0 C0
G1 A5 C5
G92 E0
M114
GET_POSITION
SAVE_GCODE_STATE NAME=test
G1 X20 A-20
RESTORE_GCODE_STATE NAME=test MOVE=1
SET_GCODE_OFFSET Z=0.1 MOVE=1
SET_SKEW XY=140.4,142.8,99.8

EXCLUDE_OBJECT_DEFINE NAME=part CENTER=50,50 POLYGON=[[40,40],[60,40],[60,60],[40,60]]
EXCLUDE_OBJECT_START NAME=part
G1 X55 Y55 A15 E4
EXCLUDE_OBJECT_END NAME=part
EXCLUDE_OBJECT NAME=part
EXCLUDE_OBJECT_START NAME=part
G1 X45 Y45 A20 E5
EXCLUDE_OBJECT_END NAME=part
G1 X30 Y30 A25 E6

MANUAL_STEPPER STEPPER=c GCODE_AXIS=
MANUAL_STEPPER STEPPER=c MOVE=0
MANUAL_STEPPER STEPPER=c GCODE_AXIS=C
G1 X10 C90 F3000
MANUAL_STEPPER STEPPER=a GCODE_AXIS=
MANUAL_STEPPER STEPPER=c GCODE_AXIS=
G1 X20 Y20
M84
